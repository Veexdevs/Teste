# cache do editor Godot (gerado em qualquer execução/exportação)
.godot/

# artefactos pesados de CI (engine/templates) nunca entram no repo final
.toolkit/
ci/probe-report.txt

# binários compilados: distribuídos pelo GitHub Release / Actions artifacts,
# não pelo Git (evita inchamento do repositório e do patchset)
builds/*
!builds/README.md

# Python
__pycache__/
*.pyc
