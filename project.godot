; SENTINELA - Operacao Cerrado | Godot 4.5 | nativo (sem HTML/browser)
config_version=5

[application]

config/name="SENTINELA - Operacao Cerrado"
config/description="FPS tactico militar: rounds com carga/desactivacao, balistica, cobertura e fortificacoes de campo."
config/version="1.0.0"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.5", "GLTF Compatibility")
boot_splash/bg_color=Color(0.043, 0.051, 0.058, 1)
config/icon="res://icon.png"
boot_splash/show_image=false

[autoload]

G="*res://game/core/g.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=20.0
3d/solver/solver_iterations=8

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.42, 0.51, 0.58, 1)
limits/rendering/max_lights_per_object=8
